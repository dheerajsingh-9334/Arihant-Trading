# ==============================================================
# Arihant BOS — WEB (Next.js)   →  copy to apps/web/.env.local
# NEXT_PUBLIC_* values are exposed to the browser. Put NO secrets here.
# ==============================================================

# ---- API + WebSocket endpoints ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# ---- Supabase (public client for login only) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon key is safe to expose; NEVER put the service_role key here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Cloudinary (public bits only — client uploads with a SIGNED signature
#      requested from the API; the API secret must never live in the web app) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ---- App ----
NEXT_PUBLIC_APP_NAME=Arihant BOS
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
